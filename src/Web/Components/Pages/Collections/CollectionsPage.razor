@page "/collections"
@attribute [StreamRendering]

@using Ardalis.Result
@using Core.Features.Collections

<PageTitle>Collections</PageTitle>

<h3>Collections</h3>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="card card-body">
            <AddCollectionForm />
        </div>
    </div>
</div>


<Grid TItem="CollectionDto"
    Class="table table-hover table-bordered table-striped"
    DataProvider="CollectionsDataProvider"
    AllowPaging="true"
    PageSize="5"
    Responsive="true">

    <GridColumn TItem="CollectionDto" HeaderText="Title" PropertyName="Title">
        <NavLink href="@($"/collections/{@context.PublicId}")">@context.Title</NavLink>
    </GridColumn>

    <GridColumn TItem="CollectionDto" HeaderText="Description" PropertyName="Description">
        @context.Description
    </GridColumn>

    <GridColumn TItem="CollectionDto" HeaderText="Created At" PropertyName="CreatedAt">
        @context.CreatedAt.ToLocalTime()
    </GridColumn>
</Grid>

@code {
    private async Task<GridDataProviderResult<CollectionDto>> CollectionsDataProvider(GridDataProviderRequest<CollectionDto> request)
    {
        var result = await Mediator.Send(new GetCollections()
        {
            Page = request.PageNumber,
            PerPage = request.PageSize
        });

        return await Task.FromResult(new GridDataProviderResult<CollectionDto> { Data = result.Value, TotalCount = (int)result.PagedInfo.TotalRecords });
    }
}
