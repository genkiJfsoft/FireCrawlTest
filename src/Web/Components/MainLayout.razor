@inherits LayoutComponentBase

@inject NavigationManager NavigationManager

<div class="bb-page">
    <MainSidebar />

    <main>
        <div class="bb-top-row px-4 gap-3 d-flex justify-content-end">
            <a href="https://docs.microsoft.com/aspnet/" target="_blank" class="btn btn-link">About</a>
            <NavLink href="contact" class="btn btn-link">Contact</NavLink>

            <AuthorizeView>
                <Authorized>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="btn btn-link">
                            Logout
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="Account/Register" class="btn btn-link">
                        Register
                    </NavLink>
                    <NavLink href="Account/Login" class="btn btn-link">
                        Login
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            <div class="py-2">@Body</div>
        </article>
    </main>

</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

<Preload LoadingText="Loading..." />
<Toasts class="p-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight" />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>