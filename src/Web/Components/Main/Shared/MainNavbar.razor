@using Web.Components.Account.Shared
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Common.Strings> L

<header class="navbar navbar-expand-lg navbar-dark sticky-top">
    <nav class="container-lg">
        <div class="d-flex gap-3">
            <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>

            <a class="navbar-brand" href="/">
                <Icon Name="IconName.CodeSquare" />
                Dev List
            </a>
        </div>

        <div class="offcanvas-lg offcanvas-start" id="navbarSupportedContent">
            <div class="offcanvas-header px-4 pb-0">
                <h5 class="offcanvas-title text-white" id="offcanvasLabel"><Icon Name="IconName.CodeSquare" /> Dev List</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#navbarSupportedContent" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <ul class="navbar-nav mb-2 mb-lg-0">
                    <li class="nav-item">
                        <NavLink href="" Match="NavLinkMatch.All" class="nav-link">@L["Home"]</NavLink>
                    </li>

                    <li class="nav-item">
                        <NavLink href="Collections" class="nav-link">@L["Collections"]</NavLink>
                    </li>

                    <li class="nav-item">
                        <NavLink href="Contact" class="nav-link">@L["Contact"]</NavLink>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex gap-2">
            <CultureSelector @rendermode="InteractiveServer" />
            <UserMenu />
        </div>

    </nav>
</header>

