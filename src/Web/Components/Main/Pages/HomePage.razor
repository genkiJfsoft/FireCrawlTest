@page "/"
@using Core.Identity.Data
@using Web.Components.Account

@inject IStringLocalizer<HomePage> L

<PageTitle>Home</PageTitle>

<div class="container-lg">
    <AuthorizeView>
        <Authorized>
            <p>Hello, @context.User.Identity!.Name</p>

            <AuthorizeView Roles="@KnownRoles.Administrator" Context="innerContext">
                <p>You have the 'Administrator' role.</p>
            </AuthorizeView>

            <Button Type="ButtonType.Link" To="/Portal/Dashboard" Color="ButtonColor.Primary">Dashboard</Button>
        </Authorized>
        <NotAuthorized>
            <h1>@L["Welcome"]</h1>
        </NotAuthorized>
    </AuthorizeView>
</div>
