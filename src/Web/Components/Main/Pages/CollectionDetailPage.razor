@page "/Collections/{collectionId}"

@using Core.Collections.Features;
@using Core.Collections.Data;

<PageTitle>Collection</PageTitle>

<div class="container-lg">
    @if (collection == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div>
            <Breadcrumb Items="PageBreadcrumbs"></Breadcrumb>
        </div>

        <h4>@collection.Title</h4>

        <p>
            @collection.Description
        </p>

        <div class="row g-3">
            @foreach (var resource in collection.Resources)
            {
                <div class="col-md-6">
                    <Card>
                        <CardBody>
                            <CardTitle>@resource.Title</CardTitle>
                            <CardText>@resource.Notes</CardText>
                        </CardBody>
                        <CardFooter Class="d-flex">
                            <Icon Name="IconName.BoxArrowUpRight" />
                            <Button Color="ButtonColor.Link" To="@resource.LinkToUrl" Type="ButtonType.Link" Size="ButtonSize.Small" Class="text-start">
                                @resource.LinkToUrl
                            </Button>
                        </CardFooter>
                    </Card>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string CollectionId { get; set; } = null!;

    private List<BreadcrumbItem> PageBreadcrumbs { get; set; } = [];

    private CollectionData? collection;

    
    protected override async Task OnInitializedAsync()
    {
        await LoadCollectionData();

        PageBreadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem{ Text = "Collections", Href ="/Collections" },
            new BreadcrumbItem{ Text = collection?.Title ?? "", IsCurrentPage = true }
        };
    }

    protected async Task LoadCollectionData()
    {
        var result = await Mediator.Send(new GetCollection(CollectionId, true));

        if (result.IsSuccess)
        {
            collection = result.Value;
        }

        // TODO: handle not found
    }
}
