@using System.ComponentModel.DataAnnotations
@using Core.Collections.Features

<EditForm FormName="AddResourceForm" Enhance="true" Model="Model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="Title" class="form-label">Title</label>
        <InputText @bind-Value="Model!.Title" class="form-control" id="Title" />
        <ValidationMessage For="() => Model.Title" />
    </div>

    <div class="mb-3">
        <label for="Notes" class="form-label">Notes</label>
        <InputText @bind-Value="Model!.Notes" class="form-control" id="Notes" />
        <ValidationMessage For="() => Model.Notes" />
    </div>

    <div class="mb-3">
        <label for="LinkToUrl" class="form-label">Link To</label>
        <InputText @bind-Value="Model!.LinkToUrl" class="form-control" id="LinkToUrl" />
        <ValidationMessage For="() => Model.LinkToUrl" />
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Submit</button>
    </div>
</EditForm>

@code {
    [Parameter]
    public int CollectionId { get; set; }

    [Parameter]
    public EventCallback OnAdded { get; set; }

    [SupplyParameterFromForm]
    FormModel? Model { get; set; }

    string? message;

    protected override void OnInitialized() => Model ??= new();

    private async Task HandleValidSubmit(EditContext context)
    {
        // TODO: show loading indicator

        var result = await Mediator.Send(new CreateResource()
            {
                CollectionId = CollectionId,
                Title = Model!.Title,
                Notes = Model!.Notes,
                LinkToUrl = Model.LinkToUrl
            });

        // TODO: improve feedback
        if (result.IsSuccess)
        {
            message = $"Added successfully. Id: {result.Value}";
            Model = new FormModel();
            await OnAdded.InvokeAsync(result);
        }
        else
        {
            message = "Error";
        }
    }

    class FormModel
    {
        [Required]
        public string Title { get; set; } = null!;

        [Required]
        public string Notes { get; set; } = null!;

        [Required]
        public string LinkToUrl { get; set; } = null!;
    }
}
