@using System.Security.Claims

<Sidebar @ref="sidebar"
    IconName="IconName.CodeSquare"
    Title="Dev List"
    DataProvider="SidebarDataProvider" />

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private ClaimsPrincipal currentUser = default!;

    protected override async Task OnInitializedAsync()
    {
        currentUser = (await AuthState).User;
    }

    Sidebar sidebar = default!;

    List<NavItem> navItems = [];

    private async Task<SidebarDataProviderResult> SidebarDataProvider(SidebarDataProviderRequest request)
    {
        if (!navItems.Any())
        {
            LoadNavItems();
        }

        return await Task.FromResult(request.ApplyTo(navItems));
    }

    private void LoadNavItems()
    {
        var manageNavItemId = Guid.NewGuid().ToString();

        navItems.Add(new NavItem { Id = Guid.NewGuid().ToString(), Href = "/Portal/Dashboard", IconName = IconName.Speedometer, Text = "Dashboard" });
        navItems.Add(new NavItem { Id = manageNavItemId, IconName = IconName.BriefcaseFill, Text = "Manage" });
        navItems.Add(new NavItem { Id = Guid.NewGuid().ToString(), ParentId = manageNavItemId, Href = "/Portal/Manage/Collections", IconName = IconName.CardList, Text = "Collections" });

        if (currentUser.IsInRole(KnownRoles.Administrator))
        {
            navItems.Add(new NavItem { Id = Guid.NewGuid().ToString(), Href = "/Portal/AdminOnly", IconName = IconName.BriefcaseFill, Text = "Admin" });
        }
    }
}
