@page "/Portal/Manage/Collections/{CollectionPublicId}"

@using Core.Collections.Features;
@using Core.Collections.Data;

<PageTitle>Collection</PageTitle>

@if (collection == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div>
        <Breadcrumb Items="PageBreadcrumbs"></Breadcrumb>
    </div>

    <h4>@collection.Title</h4>

    <p>
        @collection.Description
    </p>

    <Button Color="ButtonColor.Primary" @onclick="ShowAddResourceModal" class="mb-3">Add Resource</Button>

    <Grid @ref="grid"
            TItem="ResourceData"
            Class="table table-hover table-bordered table-striped"
            DataProvider="ResourceDataProvider"
            AllowPaging="true"
            PageSize="5"
            Responsive="true">

        <GridColumn TItem="ResourceData" HeaderText="Title" PropertyName="Title">
            @context.Title
        </GridColumn>

        <GridColumn TItem="ResourceData" HeaderText="Notes" PropertyName="Notes">
            @context.Notes
        </GridColumn>

        <GridColumn TItem="ResourceData" HeaderText="Link" PropertyName="LinkToUrl">
            <a href="@context.LinkToUrl" target="_blank">@context.LinkToUrl</a>
        </GridColumn>
    </Grid>

    <AddResourceModal @ref="addResourceModal" CollectionId="@collection.Id" OnAdded="HandleOnAddedResource" />
}

@code {
    [Parameter]
    public string CollectionPublicId { get; set; } = null!;

    private List<BreadcrumbItem> PageBreadcrumbs { get; set; } = [];

    private AddResourceModal addResourceModal = default!;

    private CollectionData? collection;

    private Grid<ResourceData> grid = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadCollectionData();

        PageBreadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem{ Text = "Manage" },
            new BreadcrumbItem{ Text = "Collections", Href ="/Portal/Manage/Collections" },
            new BreadcrumbItem{ Text = collection?.PublicId ?? "", IsCurrentPage = true }
        };
    }

    protected async Task LoadCollectionData()
    {
        var result = await Mediator.Send(new GetCollection(CollectionPublicId));

        if (result.IsSuccess)
        {
            collection = result.Value;
        }

        // TODO: handle not found
    }

    private async Task<GridDataProviderResult<ResourceData>> ResourceDataProvider(GridDataProviderRequest<ResourceData> request)
    {
        if (collection == null)
        {
            return await Task.FromResult(request.ApplyTo([]));
        }

        var result = await Mediator.Send(new GetResourcesByCollectionId()
        {
            CollectionId = collection.Id,
            Page = request.PageNumber,
            PerPage = request.PageSize
        });

        return await Task.FromResult(new GridDataProviderResult<ResourceData> { Data = result.Value.Items, TotalCount = result.Value.TotalCount });
    }

    private async Task ShowAddResourceModal()
    {
        await addResourceModal.ShowAsync();
    }

    private async Task HandleOnAddedResource()
    {
        await grid.RefreshDataAsync();
        await addResourceModal.HideAsync();

        ToastService.Notify(new(ToastType.Success, $"Added new Resource successfully."));
    }
}
