@page "/Portal/Manage/Collections"
@attribute [StreamRendering]

@using Core.Collections.Data
@using Core.Collections.Features
@using Core.Common.Data
@inject NavigationManager NavigationManager

<PageTitle>Collections</PageTitle>

<div>
    <Breadcrumb Items="PageBreadcrumbs"></Breadcrumb>
</div>

<h4>Collections</h4>

<Button Color="ButtonColor.Primary" @onclick="NavigateToAddPage" class="mb-3">Add</Button>

<Grid @ref="grid"
        TItem="CollectionData"
        Class="table table-hover table-bordered table-striped"
        DataProvider="CollectionsDataProvider"
        AllowPaging="true"
        PageSize="5"
      Responsive="true">

    <GridColumn TItem="CollectionData" HeaderText="Id" PropertyName="Id">
        <NavLink href="@($"/Portal/Manage/Collections/{context.PublicId}")" class="">@context.PublicId</NavLink>
    </GridColumn>

    <GridColumn TItem="CollectionData" HeaderText="Title" PropertyName="Title">
        @context.Title
    </GridColumn>

    <GridColumn TItem="CollectionData" HeaderText="Description" PropertyName="Description">
        @context.Description
    </GridColumn>

    <GridColumn TItem="CollectionData" HeaderText="Last Modified" PropertyName="LastModifiedAt">
        @context.LastModifiedAt?.ToLocalTime().ToString("G")
    </GridColumn>

    <GridColumn TItem="CollectionData" HeaderText="">
        <Button Type="ButtonType.Link" Color="ButtonColor.Secondary" Size="ButtonSize.Small" To="@($"/Portal/Manage/Collections/{context.PublicId}/Edit")">
            <Icon Name="IconName.PencilSquare" />
        </Button>

        <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => ShowDeleteCollectionDialog(context)">
            <Icon Name="IconName.TrashFill" />
        </Button>
    </GridColumn>
</Grid>

<ConfirmDialog @ref="dialog" />

@code {
    private Grid<CollectionData> grid = default!;

    private ConfirmDialog dialog = default!;

    private List<BreadcrumbItem> PageBreadcrumbs { get; set; } = [];

    protected override void OnInitialized()
    {
        PageBreadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem{ Text = "Manage" },
            new BreadcrumbItem{ Text = "Collections", IsCurrentPage = true },
        };
    }

    private async Task<GridDataProviderResult<CollectionData>> CollectionsDataProvider(GridDataProviderRequest<CollectionData> request)
    {
        var result = await Mediator.Send(new GetCollections()
            {
                Page = request.PageNumber,
                PerPage = request.PageSize
            });

        return await Task.FromResult(new GridDataProviderResult<CollectionData> { Data = result.Value.Items, TotalCount = result.Value.TotalCount });
    }

    private async Task ShowDeleteCollectionDialog(CollectionData c)
    {
        var confirmation = await dialog.ShowAsync(
            title: $"Are you sure you want to delete the Collection #{c.PublicId}?",
            message1: "This will also deletes the Resources in this Collection can not be rolled back.",
            message2: "Do you want to proceed?");

        if (confirmation)
        {
            var result = await Mediator.Send(new DeleteCollection(c.Id));

            if (result.IsSuccess)
            {
                await grid.RefreshDataAsync();

                ToastService.Notify(new(ToastType.Success, $"Collection deleted successfully."));
            }
        }
        else
        {
            // do whatever
        }
    }

    private void NavigateToAddPage()
    {
        NavigationManager.NavigateTo("/Portal/Manage/Collections/Add");
    }
}