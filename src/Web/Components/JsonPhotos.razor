@inject JsonPlaceholderService JsonPlaceholderService


<h3>JSONPlaceholder Photos</h3>

@if (photos == null)
{
    <p>Loading photos...</p>
}
else
{
    <div style="display: flex; flex-wrap: wrap; gap: 10px;">

            @foreach (var photo in photos.Take(20)) // Show only the first 20 photos
        {
            <div style="width: 150px; text-align: center; margin: 10px;">
                <img src="@photo.ThumbnailUrl" alt="@photo.Title" style="width: 100%; height: auto;" />
                <p>@photo.Title</p>
            </div>
        }
    </div>
}


@code {
    private List<Photo>? photos;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            photos = await JsonPlaceholderService.GetPhotosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}
