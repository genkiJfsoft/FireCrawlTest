{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=devlist;User=SA;Password=Strong@Passw0rd;Encrypt=false;TrustServerCertificate=true"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "PublicStorage": {
    "Path": "../storage",
    "RequestPath": "/Files"
  },
  "Mailer": {
    "SmtpServer": "smtp.myserver.com",
    "SmtpPort": 465,
    "SmtpUsername": "smtpusername",
    "SmtpPassword": "smtppassword",
    "MailFrom": {
      "Name": "Support",
      "Address": "support@example.com"
    }
  },
  "AllowedHosts": "*"
}
