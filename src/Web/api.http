# For more info on HTTP files go to https://aka.ms/vs/httpfile

@Web_HostAddress = https://localhost:7100

# GET Get collections
GET {{Web_HostAddress}}/api/Collections
Content-Type: application/json
{
}

###
# POST Create new collection
POST {{Web_HostAddress}}/api/Collections
Content-Type: application/json
{
    "title": "Usefull links",
    "description": "Usefull links for web dev"
}
###

# POST Send Contact Enquiry
POST {{Web_HostAddress}}/api/Enquiries
Content-Type: application/json
{
  "title": "Contact Form",
  "name": "test",
  "email": "test@test.com",
  "subject": "General Enquiry",
  "message": "Hello World!"
}
###